# Desenvolvimento local com mocks. Sem segredos — arquivo versionado.
# Ativa a camada de mocks (MSW REST + Socket.IO). "true" no dev e no build de demonstração.
VITE_ENABLE_MOCKS=true
# Base das chamadas REST (Axios). Com mocks, os handlers MSW interceptam esta origem.
VITE_API_BASE_URL=/api
# URL do servidor Socket.IO. Com mocks, o MSW intercepta a conexão WebSocket.
VITE_SOCKET_URL=wss://realtime.nft-marketplace.mock
# Cenário inicial dos mocks (ver README > Cenários).
VITE_MOCK_SCENARIO=default
